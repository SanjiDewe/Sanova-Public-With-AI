# SANOVA remains sandbox-only in this phase.
# Deployment identity storage: set this to the Neon PostgreSQL connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SANOVA_ENVIRONMENT=sandbox
SANOVA_LIVE_EXECUTION=false

# Sandbox network calls are OFF by default. Set true only for sandbox integration testing.
SANOVA_SANDBOX_HTTP_ENABLED=false

# HTTPS deployment: keep session cookies secure.
# SANOVA_FORCE_HTTPS=true
SANOVA_COOKIE_SECURE=true

# Container deployments use the writable ephemeral filesystem under /tmp.
SANOVA_DATA_DIR=/tmp/sanova
SANOVA_STATE_DIR=/tmp/sanova/tasks
SANOVA_AUDIT_DIR=/tmp/sanova/audit

# Supply only SANDBOX credentials when we explicitly test provider connectivity.
# SANOVA_PRODIGI_SANDBOX_API_KEY=
# SANOVA_PRODIGI_SANDBOX_BASE_URL=
# SANOVA_CLOUDPRINTER_SANDBOX_API_KEY=
# SANOVA_CLOUDPRINTER_SANDBOX_BASE_URL=

# Pluggable integration providers. Change these values to swap adapters.
SANOVA_EMAIL_PROVIDER=mock
SANOVA_OAUTH_PROVIDER=mock
# SANOVA_DISABLED_PHYSICAL_PROVIDERS=prodigi,cloudprinter

# Brevo (only required when SANOVA_EMAIL_PROVIDER=brevo)
# SANOVA_BREVO_API_KEY=
# SANOVA_BREVO_BASE_URL=https://api.brevo.com/v3
# SANOVA_EMAIL_FROM=
# SANOVA_EMAIL_TIMEOUT_SECONDS=15

# Google OAuth (only required when SANOVA_OAUTH_PROVIDER=google)
# SANOVA_GOOGLE_CLIENT_ID=
# SANOVA_GOOGLE_CLIENT_SECRET=
# SANOVA_GOOGLE_REDIRECT_URI=
# SANOVA_GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/spreadsheets
# SANOVA_GOOGLE_TOKEN_ENCRYPTION_KEY=  # Fernet key for stored Google tokens
# SANOVA_GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# SANOVA_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# SANOVA_GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
# SANOVA_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# SANOVA_OAUTH_TIMEOUT_SECONDS=15

# Sanova AI: provider credentials/models are managed at runtime from Super Admin.
# Do NOT add provider API keys or model lists here.
# AI credentials are encrypted at rest using this application-level key.
# This is NOT an OpenAI/Anthropic/Google API key.
# SANOVA_AI_CREDENTIAL_KEY=
SANOVA_AI_STATE_DIR=/tmp/sanova/ai

# Privileged Super Admin area gate (keep this secret; do not commit real values)
# SANOVA_SUPER_ADMIN_ACCESS_CODE=
